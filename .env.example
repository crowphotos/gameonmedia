# Copy this file to `.env` and fill in your real values.
# `.env` is git-ignored and must NEVER be committed.

# --- WordPress ---
WP_SITE_URL=https://gameon.media
WP_USERNAME=your_wp_username
# Application Password from WP admin -> Users -> Profile -> Application Passwords.
# Spaces are fine; the script strips them.
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Optional; defaults to "News" if omitted.
DEFAULT_CATEGORY=News

# --- Gmail ---
# Same syntax as the Gmail search box, e.g.:
#   from:newsletters@example.com newer_than:30d
#   label:Press subject:(tour OR concert)
GMAIL_QUERY=label:ArticlesGameOn newer_than:15d
